# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA DE MONITOREO SOLAR LOCAL
# ==============================================================================

# --- Modo de conexión con el Inversor ---
# Opciones: "MODBUS_RTU" (Cable USB/RS485 directo a la Mac), 
#           "ESP32_TCP" (Puente Wi-Fi vía socket TCP),
#           "SIMULATOR" (Simulador realista para pruebas sin hardware conectado)
CONNECTION_MODE=SIMULATOR

# --- Configuración Serial / Modbus RTU (Si CONNECTION_MODE=MODBUS_RTU) ---
SERIAL_PORT=/dev/tty.usbserial-1410
SERIAL_BAUDRATE=9600
MODBUS_SLAVE_ID=1

# --- Configuración Puente ESP32 (Si CONNECTION_MODE=ESP32_TCP) ---
ESP32_HOST=192.168.1.50
ESP32_PORT=8888

# --- Parámetros del Banco de Baterías (Para cálculo y respaldo de SOC) ---
# Ejemplo: Sistema de 48V (LiFePO4 o AGM) o 24V / 12V
BATTERY_NOMINAL_VOLTAGE=48.0
BATTERY_MIN_VOLTAGE=44.0
BATTERY_MAX_VOLTAGE=56.4

# --- Configuración del Broker MQTT Local (Mosquitto en MacBook) ---
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_TOPIC_TELEMETRY=hogar/solar/telemetria
MQTT_TOPIC_HISTORY=hogar/solar/historial_24h
MQTT_TOPIC_ALERT=hogar/solar/alerta
POLL_INTERVAL_SECONDS=1.5

# --- Sistema de Alertas Críticas (< 30% Batería) ---
CRITICAL_SOC_THRESHOLD=30.0
ALERT_COOLDOWN_SECONDS=900

# 1) Telegram Bot API (100% Gratuito - Mensajes de voz / Alerta prioritaria)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# 2) CallMeBot API (100% Gratuito - Llamada telefónica real a Telegram/WhatsApp)
# Para activar: habla con @CallMeBot_txtbot en Telegram o autoriza tu usuario
CALLMEBOT_ENABLED=false
CALLMEBOT_USER=@tu_usuario_telegram
